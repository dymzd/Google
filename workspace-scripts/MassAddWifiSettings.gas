// Load the service account credentials for OAuth authentication
var CLIENT_ID = '.apps.googleusercontent.com'; // Replace with your Google Client ID
var CLIENT_SECRET = 'XXXXX-XXXXX-XXXXXXXXXXXXXX'; // Replace with your Google Client Secret
var CUSTOMER_ID = 'XXXXXXXXX'; // Replace with your Google Customer ID

/**
 * Creates a custom menu in Google Sheets on open.
 */
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Admin Tools')
    .addItem('Add WiFi Settings from Sheet', 'addWifi')
    .addToUi();
}

/**
 * Applies WiFi network settings to Organizational Units based on spreadsheet data.
 */
function addWifi() {
  var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = spreadsheet.getSheetByName('Wifi Settings');
  var ui = SpreadsheetApp.getUi();

  if (!sheet) {
    ui.alert("Error: Sheet named 'Wifi Settings' was not found.");
    return;
  }

  var data = sheet.getDataRange().getValues();
  if (data.length <= 1) {
    ui.alert("No WiFi configuration data found in 'Wifi Settings' (excluding header row).");
    return;
  }

  var service = getOAuthService();
  if (!service.hasAccess()) {
    var authUrl = service.getAuthorizationUrl();
    Logger.log('Please authorize the script by visiting: ' + authUrl);
    ui.alert('OAuth Authorization Required:\n' + authUrl);
    return;
  }

  // Pre-fetch all Org Units to avoid repetitive API calls per row
  var orgUnitMap = buildOrgUnitMap();

  var options = {
    method: 'post',
    headers: {
      Authorization: 'Bearer ' + service.getAccessToken(),
      'Content-Type': 'application/json'
    },
    muteHttpExceptions: true
  };

  var successCount = 0;
  var errors = [];

  // Start from row 1 (skipping header row 0)
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var ouName = String(row[0] || '').trim();
    if (!ouName) continue; // Skip blank lines

    var ouID = orgUnitMap[ouName];
    if (!ouID) {
      errors.push(`Row ${i + 1} (${ouName}): Organizational Unit not found.`);
      continue;
    }

    var allowForChromeUsers = Boolean(row[1]);
    var allowForChromeDevices = Boolean(row[2]);
    var name = String(row[3] || '');
    var ssid = String(row[4] || '');
    var hiddenSsid = Boolean(row[5]);
    var automaticallyConnect = Boolean(row[6]);
    var authType = String(row[7] || 'WPA_PSK');
    var password = String(row[8] || '');
    var allowIpConfiguration = Boolean(row[9]);
    var allowNameServersConfiguration = Boolean(row[10]);
    var nameServerSelectionRaw = String(row[11] || 'AUTOMATIC').trim().toUpperCase();
    var customNameServers = String(row[12] || '').trim();

    var nameServerSelection = "NAME_SERVERS_ENUM_AUTOMATIC";
    var customServersList = [];
    if (nameServerSelectionRaw === "CUSTOM") {
      nameServerSelection = "NAME_SERVERS_ENUM_CUSTOM";
      if (customNameServers) {
        customServersList = customNameServers.split(',').map(s => s.trim()).filter(Boolean);
      }
    }

    var wifiDetails = {
      "ssid": ssid,
      "hiddenSsid": hiddenSsid,
      "automaticallyConnect": automaticallyConnect,
      "security": authType,
      "passphrase": password,
      "proxySettings": { "type": "Direct" },
      "allowIpConfiguration": allowIpConfiguration,
      "allowNameServersConfiguration": allowNameServersConfiguration,
      "nameServerSelection": nameServerSelection
    };

    if (nameServerSelection === "NAME_SERVERS_ENUM_CUSTOM" && customServersList.length > 0) {
      wifiDetails["customNameServers"] = customServersList;
    }

    var payload = {
      "name": name,
      "targetResource": "orgunits/" + ouID,
      "settings": [
        {
          "policySchema": "chrome.networks.wifi.Details",
          "value": { "details": wifiDetails }
        },
        {
          "policySchema": "chrome.networks.wifi.AllowForChromeDevices",
          "value": { "allowForChromeDevices": allowForChromeDevices }
        },
        {
          "policySchema": "chrome.networks.wifi.AllowForChromeUsers",
          "value": { "allowForChromeUsers": allowForChromeUsers }
        }
      ]
    };

    var url = 'https://chromepolicy.googleapis.com/v1/customers/' + CUSTOMER_ID + '/policies/networks:defineNetwork';
    options.payload = JSON.stringify(payload);

    try {
      var response = UrlFetchApp.fetch(url, options);
      var responseCode = response.getResponseCode();
      if (responseCode === 200) {
        successCount++;
        Logger.log('Successfully applied WiFi settings for OU: ' + ouName);
      } else {
        var errBody = response.getContentText();
        Logger.log(`Failed to apply WiFi settings for OU ${ouName} (${responseCode}): ${errBody}`);
        errors.push(`Row ${i + 1} (${ouName}): HTTP ${responseCode}`);
      }
    } catch (e) {
      Logger.log(`Exception applying WiFi settings for OU ${ouName}: ${e.message}`);
      errors.push(`Row ${i + 1} (${ouName}): ${e.message}`);
    }
  }

  var summaryMsg = `WiFi settings update complete.\nSuccessfully applied: ${successCount}`;
  if (errors.length > 0) {
    summaryMsg += `\nErrors (${errors.length}):\n` + errors.join('\n');
  }
  ui.alert(summaryMsg);
}

/**
 * Pre-fetches all OUs and maps OU name to clean Org Unit ID.
 */
function buildOrgUnitMap() {
  var map = {};
  var customerId = 'my_customer';
  try {
    var response = AdminDirectory.Orgunits.list(customerId, { type: 'all' });
    var orgUnits = response.organizationUnits || [];
    for (var i = 0; i < orgUnits.length; i++) {
      var ou = orgUnits[i];
      var cleanId = ou.orgUnitId;
      if (cleanId && cleanId.startsWith("id:")) {
        cleanId = cleanId.substring(3);
      }
      map[ou.name] = cleanId;
    }
  } catch (e) {
    Logger.log('Error fetching Org Units: ' + e.message);
  }
  return map;
}

/**
 * Configure OAuth2 service for Chrome Policy API.
 */
function getOAuthService() {
  return OAuth2.createService('ChromePolicy')
    .setAuthorizationBaseUrl('https://accounts.google.com/o/oauth2/auth')
    .setTokenUrl('https://oauth2.googleapis.com/token')
    .setClientId(CLIENT_ID)
    .setClientSecret(CLIENT_SECRET)
    .setCallbackFunction('authCallback')
    .setPropertyStore(PropertiesService.getUserProperties())
    .setScope('https://www.googleapis.com/auth/chrome.management.policy');
}

/**
 * OAuth callback handler.
 */
function authCallback(request) {
  var service = getOAuthService();
  var authorized = service.handleCallback(request);
  if (authorized) {
    return HtmlService.createHtmlOutput('<h3>Authentication Successful</h3><p>You can close this tab and return to the spreadsheet.</p>');
  } else {
    return HtmlService.createHtmlOutput('<h3>Authentication Denied</h3><p>Authorization was not completed.</p>');
  }
}

/**
 * Resets OAuth stored credentials.
 */
function resetOAuthService() {
  OAuth2.createService('ChromePolicy').reset();
}
