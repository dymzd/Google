// Column indices in the spreadsheet (0-indexed)
const OU_COLUMN_INDEX = 0; // Column A: Organizational Unit (OU) Name
const PARENT_OU_COLUMN_INDEX = 1; // Column B: Parent OU Path (e.g., '/' or '/Sales')

/**
 * Creates a custom menu in Google Sheets on open.
 */
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Admin Tools')
    .addItem('Add OUs from Sheet', 'addOUs')
    .addToUi();
}

/**
 * Creates Organizational Units in Google Workspace from spreadsheet data.
 * Requires the 'AdminDirectory' Advanced Google Service to be enabled.
 */
function addOUs() {
  const ui = SpreadsheetApp.getUi();
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = spreadsheet.getSheetByName('OU Settings');

  if (!sheet) {
    ui.alert("Error: Sheet named 'OU Settings' was not found. Please create it and try again.");
    return;
  }

  const lastRow = sheet.getLastRow();
  if (lastRow <= 1) {
    ui.alert("No data found in 'OU Settings'. Please add OU data starting from Row 2.");
    return;
  }

  // Fetch values starting from row 2 (headers on row 1)
  const numRows = lastRow - 1;
  const values = sheet.getSheetValues(2, 1, numRows, 2);
  const failedOUs = [];
  let successCount = 0;

  values.forEach((row, index) => {
    const ouName = String(row[OU_COLUMN_INDEX] || '').trim();
    let parentPath = String(row[PARENT_OU_COLUMN_INDEX] || '').trim();

    if (!ouName) {
      return; // Skip empty rows
    }

    if (!parentPath) {
      parentPath = '/';
    } else if (!parentPath.startsWith('/')) {
      parentPath = '/' + parentPath;
    }

    const resource = {
      name: ouName,
      parentOrgUnitPath: parentPath,
    };

    try {
      AdminDirectory.Orgunits.insert(resource, 'my_customer');
      successCount++;
    } catch (e) {
      Logger.log(`Failed to create OU '${ouName}' under '${parentPath}': ${e.message}`);
      failedOUs.push(`${ouName} (${parentPath})`);
    }
  });

  let message = `Process completed. Successfully created: ${successCount} OU(s).`;
  if (failedOUs.length > 0) {
    message += `\n\nFailed to create ${failedOUs.length} OU(s) (they may already exist or parent path is invalid):\n` + failedOUs.join('\n');
  }
  ui.alert(message);
}
